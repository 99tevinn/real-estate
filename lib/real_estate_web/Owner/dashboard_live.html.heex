<%!-- lib/real_estate_web/live/owner/dashboard_live.html.heex --%>
<div>
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Owner Dashboard</h1>
    <p class="text-gray-500 text-sm mt-1">Manage your properties and enquiries</p>
  </div>

  <%!-- Stat cards --%>
  <div class="grid grid-cols-2 gap-6 mb-10">
    <div class="bg-gray-900 text-white rounded-xl p-6">
      <p class="text-gray-400 text-sm mb-1">My Properties</p>
      <p class="text-4xl font-bold"><%= length(@properties) %></p>
    </div>
    <div class="bg-green-600 text-white rounded-xl p-6">
      <p class="text-green-200 text-sm mb-1">Enquiries Received</p>
      <p class="text-4xl font-bold"><%= length(@enquiries) %></p>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <%!-- My properties --%>
    <div class="bg-white rounded-xl border shadow-sm">
      <div class="px-6 py-4 border-b flex items-center justify-between">
        <h2 class="font-bold text-gray-900">My Properties</h2>
        <.link href={~p"/owner/properties/new"}
          class="text-xs bg-gray-900 text-white px-3 py-1.5 rounded-lg hover:bg-gray-700 transition">
          + Add
        </.link>
      </div>
      <ul class="divide-y">
        <li :for={prop <- @properties} class="px-6 py-4 hover:bg-gray-50">
          <p class="font-medium text-sm text-gray-900"><%= prop.title %></p>
          <p class="text-xs text-gray-500 mt-0.5 flex items-center gap-1">
            <span>📍</span><%= prop.location %>
          </p>
          <div class="flex items-center justify-between mt-2">
            <p class="text-sm font-bold">KES <%= prop.price %></p>
            <span class={[
              "text-xs px-2 py-0.5 rounded-full font-medium",
              prop.status == "available" && "bg-green-100 text-green-700",
              prop.status == "sold"      && "bg-gray-100 text-gray-600",
              prop.status == "rented"    && "bg-blue-100 text-blue-700"
            ]}>
              <%= prop.status %>
            </span>
          </div>
        </li>
        <li :if={Enum.empty?(@properties)}
          class="px-6 py-8 text-center text-gray-400 text-sm">
          No properties yet
        </li>
      </ul>
    </div>

    <%!-- Enquiries --%>
    <div class="bg-white rounded-xl border shadow-sm">
      <div class="px-6 py-4 border-b flex items-center justify-between">
        <h2 class="font-bold text-gray-900">Enquiries</h2>
        <.link href={~p"/owner/enquiries"}
          class="text-xs text-blue-600 hover:underline">
          View all →
        </.link>
      </div>
      <ul class="divide-y">
        <li :for={enq <- @enquiries} class="px-6 py-4 hover:bg-gray-50">
          <p class="font-medium text-sm text-gray-900"><%= enq.property.title %></p>
          <p class="text-xs text-gray-500 mt-0.5 truncate"><%= enq.message %></p>
          <div class="flex items-center justify-between mt-2">
            <p class="text-xs text-gray-400">
              <%= enq.buyer.full_name || enq.buyer.email %>
            </p>
            <span class={[
              "text-xs px-2 py-0.5 rounded-full font-medium",
              enq.status == "pending" && "bg-yellow-100 text-yellow-700",
              enq.status == "replied" && "bg-green-100 text-green-700",
              enq.status == "closed"  && "bg-gray-100 text-gray-500"
            ]}>
              <%= enq.status %>
            </span>
          </div>
        </li>
        <li :if={Enum.empty?(@enquiries)}
          class="px-6 py-8 text-center text-gray-400 text-sm">
          No enquiries yet
        </li>
      </ul>
    </div>
  </div>
</div>