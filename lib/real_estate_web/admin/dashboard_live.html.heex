<%!-- live/admin/dashboard_live.html.heex --%>
<div class="p-6">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
        Admin Dashboard
        <span class="flex h-2 w-2 rounded-full bg-green-500 animate-pulse" title="Live Sync Active"></span>
      </h1>
      <p class="text-gray-500 text-sm mt-1">System overview and recent activity</p>
    </div>
  </div>

  <%!-- Stat cards --%>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="bg-gray-900 text-white rounded-xl p-6 shadow-lg">
      <p class="text-gray-400 text-sm mb-1 uppercase tracking-wider font-semibold">Total Users</p>
      <p class="text-4xl font-bold">{@total_users}</p>
    </div>
    
    <div class="bg-blue-600 text-white rounded-xl p-6 shadow-lg">
      <p class="text-blue-200 text-sm mb-1 uppercase tracking-wider font-semibold">Total Properties</p>
      <p class="text-4xl font-bold">{@total_properties}</p>
    </div>
    
    <div class="bg-green-600 text-white rounded-xl p-6 shadow-lg">
      <p class="text-green-200 text-sm mb-1 uppercase tracking-wider font-semibold">Total Enquiries</p>
      <p class="text-4xl font-bold">{@total_enquiries}</p>
    </div>
  </div>

  <%!-- Recent users --%>
  <div class="bg-white rounded-xl border shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b flex justify-between items-center bg-white">
      <h2 class="font-bold text-gray-900">Recent Registrations</h2>
      <.link 
        href={~p"/admin/users"} 
        class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors flex items-center gap-1"
      >
        View all users <span>&rarr;</span>
      </.link>
    </div>

    <%= if @recent_users == [] do %>
      <div class="p-12 text-center text-gray-500 italic">
        No recent registrations found.
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
              <th class="px-6 py-3 text-left font-semibold">User Details</th>
              <th class="px-6 py-3 text-left font-semibold">Role</th>
              <th class="px-6 py-3 text-left font-semibold">Joined Date</th>
              <th class="px-6 py-3 text-right font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr :for={user <- @recent_users} class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4">
                <div class="font-bold text-gray-900">{user.full_name || "—"}</div>
                <div class="text-xs text-gray-500">{user.email}</div>
              </td>
              
              <td class="px-6 py-4">
                <span class={[
                  "text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase tracking-tight",
                  user.role == "admin" && "bg-red-100 text-red-700",
                  user.role == "agent" && "bg-blue-100 text-blue-700",
                  user.role == "owner" && "bg-green-100 text-green-700",
                  user.role == "buyer" && "bg-yellow-100 text-yellow-700"
                ]}>
                  {user.role}
                </span>
              </td>
              
              <td class="px-6 py-4 text-gray-600">
                {Calendar.strftime(user.inserted_at, "%d %b %Y")}
              </td>

              <td class="px-6 py-4 text-right">
                <.link 
                  href={~p"/admin/users/#{user.id}/edit"} 
                  class="text-blue-600 hover:underline font-medium"
                >
                  Edit
                </.link>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>