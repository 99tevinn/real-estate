<%!-- lib/real_estate_web/controllers/page_html/home.html.heex --%>

<%!-- Stats bar --%>
<div class="bg-blue-600 text-white py-6 px-6">
  <div class="max-w-4xl mx-auto grid grid-cols-3 gap-6 text-center">
    <div>
      <%!-- FIX 1: Use .total_entries from the pagination struct --%>
      <p class="text-3xl font-bold"><%= @listings.total_entries %>+</p>
      <p class="text-blue-200 text-sm">Active Listings</p>
    </div>
    <%!-- ... other stats ... --%>
  </div>
</div>

<%!-- Featured listings --%>
<div class="max-w-6xl mx-auto px-6 py-16">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold">Featured Properties</h2>
    <.link href={~p"/listings"} class="text-blue-600 font-medium hover:underline text-sm">
      View all →
    </.link>
  </div>

  <%!-- FIX 2: Use .entries to check if empty --%>
  <%= if Enum.empty?(@listings.entries) do %>
    <div class="text-center py-16 bg-gray-100 rounded-xl">
      <p class="text-4xl mb-4">🏘️</p>
      <p class="text-gray-500">No properties listed yet.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <%!-- FIX 3: Use .entries for the loop --%>
      <div :for={prop <- Enum.take(@listings.entries, 6)}
        class="bg-white rounded-xl shadow-sm border hover:shadow-md transition overflow-hidden">
        
        <%!-- Image and Header logic remains the same --%>
        <%= if prop.image do %>
          <img src={RealEstate.Uploaders.PropertyImage.url({prop.image, prop}, :thumb)} class="w-full h-48 object-cover" />
        <% else %>
          <div class="w-full h-48 bg-gradient-to-br from-gray-800 to-gray-600 flex items-center justify-center">
            <span class="text-4xl">🏠</span>
          </div>
        <% end %>

        <div class="p-5">
           <%!-- ... type and title tags ... --%>
           
          <p class="text-xl font-bold text-gray-900 mb-4">
            <%!-- Keeping your float conversion fix --%>
            KES <%= :erlang.float_to_binary(Decimal.to_float(prop.price), [{:decimals, 0}]) %>
          </p>
          <.link href={~p"/listings/#{prop.id}"} class="block text-center bg-gray-900 hover:bg-gray-700 text-white text-sm py-2.5 rounded-lg transition font-medium">
            View Details
          </.link>
        </div>
      </div>
    </div>
  <% end %>
</div>