<div>
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Saved Properties</h1>
    <p class="text-gray-500 text-sm mt-1">Properties you have saved for later</p>
  </div>

  <%= if Enum.empty?(@saved) do %>
    <div class="text-center py-16 bg-white rounded-xl border">
      <p class="text-4xl mb-4">❤️</p>
      <p class="text-gray-500 mb-4">No saved properties yet.</p>
      <.link href={~p"/listings"}
        class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm">
        Browse listings
      </.link>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div :for={saved <- @saved}
        class="bg-white rounded-xl border shadow-sm overflow-hidden
               hover:shadow-md transition">
        <%= if saved.property.image do %>
          <img
            src={RealEstate.Uploaders.PropertyImage.url(
              {saved.property.image, saved.property}, :thumb)}
            class="w-full h-40 object-cover"
          />
        <% else %>
          <div class="w-full h-40 bg-gradient-to-br from-gray-800 to-gray-600
                      flex items-center justify-center">
            <span class="text-3xl">🏠</span>
          </div>
        <% end %>

        <div class="p-5">
          <div class="flex items-center justify-between mb-2">
            <span class={[
              "text-xs px-2 py-1 rounded-full font-medium",
              saved.property.type == "sale" && "bg-blue-100 text-blue-700",
              saved.property.type == "rent" && "bg-green-100 text-green-700"
            ]}>
              <%= if saved.property.type == "sale", do: "For Sale", else: "For Rent" %>
            </span>
            <span class="text-xs text-gray-400 capitalize">
              <%= saved.property.status %>
            </span>
          </div>

          <h3 class="font-bold text-base mb-1"><%= saved.property.title %></h3>
          <p class="text-gray-500 text-sm mb-1 flex items-center gap-1">
            <span>📍</span><%= saved.property.location %>
          </p>
          <p class="text-lg font-bold text-gray-900 mb-4">
            KES <%= saved.property.price %>
          </p>

          <div class="flex gap-2">
            <.link href={~p"/listings/#{saved.property.id}"}
              class="flex-1 text-center bg-gray-900 hover:bg-gray-700 text-white
                     text-sm py-2 rounded-lg transition font-medium">
              View
            </.link>
            <.link
              href={~p"/buyer/saved/#{saved.property_id}"}
              method="delete"
              data-confirm="Remove from saved?"
              class="flex-1 text-center bg-red-50 hover:bg-red-100 text-red-600
                     text-sm py-2 rounded-lg transition font-medium">
              Remove
            </.link>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>