<%!-- lib/real_estate_web/controllers/buyer/enquiry_html/new.html.heex --%>
<div class="max-w-2xl p-6 mx-auto">
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-blue-600 font-bold uppercase tracking-wider mb-2">
      <.link href={~p"/listings"} class="hover:underline text-gray-500 font-medium lowercase">Listings</.link>
      <span class="text-gray-300">/</span>
      <span>New Enquiry</span>
    </div>
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Send Enquiry</h1>
    <p class="text-gray-500 text-sm mt-1">Directly message the owner regarding this property.</p>
  </div>

  <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
    <%!-- Property Context Card --%>
    <div class="bg-gray-50 border-b p-6 flex justify-between items-center">
      <div>
        <p class="text-xs font-bold text-blue-600 uppercase tracking-widest mb-1">Inquiry for:</p>
        <h2 class="text-lg font-bold text-gray-900">{@property.title}</h2>
        <p class="text-xs text-gray-500 flex items-center gap-1 mt-1">
          <span class="grayscale">📍</span>{@property.location}
        </p>
      </div>
      <div class="text-right">
        <p class="text-[10px] text-gray-400 uppercase font-bold tracking-tighter">Asking Price</p>
        <p class="text-xl font-black text-gray-900 leading-none mt-1">
          <span class="text-xs font-normal mr-0.5">KES</span>{@property.price}
        </p>
      </div>
    </div>

    <div class="p-8">
      <.form :let={f} for={@changeset} action={~p"/buyer/enquiries"} method="post" class="space-y-6">
        <%!-- Hidden field to associate enquiry with the property --%>
        <input type="hidden" name="enquiry[property_id]" value={@property.id} />

        <div class="space-y-2">
          <.input 
            field={f[:message]} 
            type="textarea" 
            label="Your Message" 
            placeholder="Introduce yourself and ask any specific questions about the property, viewing times, or terms..."
            rows="6" 
            required 
            class="focus:ring-blue-500 focus:border-blue-500"
          />
          <p class="text-[11px] text-gray-400">
            Tip: Owners respond 2x faster to messages that include preferred viewing times.
          </p>
        </div>

        <div class="flex items-center gap-4 mt-8 pt-6 border-t border-gray-50">
          <.button type="submit"
            class="bg-blue-600 text-white px-8 py-3 rounded-xl font-bold
                   hover:bg-blue-700 shadow-md shadow-blue-100 transition-all active:scale-95">
            Send Message
          </.button>
          
          <.link href={~p"/listings/#{@property.id}"}
            class="text-sm font-bold text-gray-500 hover:text-gray-700 px-4 py-3">
            Cancel
          </.link>
        </div>
      </.form>
    </div>
  </div>

  <%!-- Confidence Section --%>
  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="flex gap-3 items-start p-4 bg-blue-50/50 rounded-xl border border-blue-100">
      <span class="text-xl">🛡️</span>
      <div>
        <p class="text-xs font-bold text-blue-900 uppercase tracking-tight">Secure Communication</p>
        <p class="text-[11px] text-blue-700 leading-relaxed mt-0.5">Your contact details are only shared with the owner once they reply to your request.</p>
      </div>
    </div>
    <div class="flex gap-3 items-start p-4 bg-gray-50 rounded-xl border border-gray-200">
      <span class="text-xl">⏱️</span>
      <div>
        <p class="text-xs font-bold text-gray-900 uppercase tracking-tight">Expected Response</p>
        <p class="text-[11px] text-gray-600 leading-relaxed mt-0.5">Most property owners on this platform respond within 24 to 48 hours.</p>
      </div>
    </div>
  </div>
</div>