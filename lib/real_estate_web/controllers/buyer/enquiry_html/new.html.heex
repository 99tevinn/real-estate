<div class="mx-auto max-w-lg mt-10 p-6">
  <h1 class="text-2xl font-semibold mb-2">Enquire About Property</h1>
  <p class="text-gray-500 mb-6"><%= @property.title %> · <%= @property.location %></p>

  <.form :let={f} for={@changeset} action={~p"/buyer/enquiries"} method="post">
    <input type="hidden" name="enquiry[property_id]" value={@property.id} />

    <.input field={f[:message]} type="textarea" label="Your Message" rows="5" required />

    <.button type="submit" class="w-full mt-4">Send Enquiry</.button>
  </.form>

  <.link href={~p"/buyer"} class="mt-4 inline-block text-sm text-gray-500">
    ← Back to dashboard
  </.link>
</div>