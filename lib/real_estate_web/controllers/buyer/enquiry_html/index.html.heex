<div class="p-6">
  <h1 class="text-2xl font-semibold mb-6">My Enquiries</h1>

  <ul class="space-y-3">
    <li :for={enq <- @enquiries} class="border rounded p-4 text-sm">
      <div class="flex items-center justify-between mb-1">
        <p class="font-medium"><%= enq.property.title %></p>
        <span class={[
          "text-xs px-2 py-0.5 rounded",
          enq.status == "pending" && "bg-yellow-100 text-yellow-700",
          enq.status == "replied" && "bg-green-100 text-green-700",
          enq.status == "closed"  && "bg-gray-100 text-gray-500"
        ]}>
          <%= enq.status %>
        </span>
      </div>
      <p class="text-gray-500"><%= enq.message %></p>
      <p class="text-xs text-gray-400 mt-1">
        Sent <%= Calendar.strftime(enq.inserted_at, "%d %b %Y") %>
      </p>
    </li>
  </ul>
</div>