<div class="p-6">
  <h1 class="text-2xl font-semibold mb-6">All Enquiries</h1>

  <%= if Enum.empty?(@enquiries) do %>
    <p class="text-gray-400 text-center py-16">No enquiries yet.</p>
  <% else %>
    <table class="w-full text-sm border">
      <thead>
        <tr class="bg-gray-100">
          <th class="p-2 text-left">Property</th>
          <th class="p-2 text-left">Buyer</th>
          <th class="p-2 text-left">Message</th>
          <th class="p-2 text-left">Status</th>
          <th class="p-2 text-left">Date</th>
          <th class="p-2 text-left">Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={enq <- @enquiries} class="border-t">
          <td class="p-2"><%= enq.property.title %></td>
          <td class="p-2"><%= enq.buyer.full_name || enq.buyer.email %></td>
          <td class="p-2 max-w-xs truncate"><%= enq.message %></td>
          <td class="p-2">
            <span class={[
              "text-xs px-2 py-0.5 rounded",
              enq.status == "pending"  && "bg-yellow-100 text-yellow-700",
              enq.status == "replied"  && "bg-green-100 text-green-700",
              enq.status == "closed"   && "bg-gray-100 text-gray-500"
            ]}>
              <%= enq.status %>
            </span>
          </td>
          <td class="p-2"><%= Calendar.strftime(enq.inserted_at, "%d %b %Y") %></td>
          <td class="p-2 flex gap-3">
            <.link href={~p"/admin/enquiries/#{enq.id}"} class="text-blue-600">
              View
            </.link>
            <.link
              href={~p"/admin/enquiries/#{enq.id}"}
              method="delete"
              data-confirm="Permanently delete this enquiry?"
              class="text-red-600">
              Delete
            </.link>
          </td>
        </tr>
      </tbody>
    </table>
  <% end %>
</div>