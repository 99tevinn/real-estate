<%!-- lib/real_estate_web/controllers/admin/enquiry_html/show.html.heex --%>
<div class="mx-auto max-w-lg mt-10 p-6">
  <h1 class="text-2xl font-semibold mb-6">Enquiry Details</h1>

  <div class="border rounded p-4 text-sm space-y-3 mb-6">
    <div class="flex justify-between">
      <span class="text-gray-500">Property</span>
      <span><%= @enquiry.property.title %></span>
    </div>
    <div class="flex justify-between">
      <span class="text-gray-500">Buyer</span>
      <span><%= @enquiry.buyer.full_name || @enquiry.buyer.email %></span>
    </div>
    <div class="flex justify-between">
      <span class="text-gray-500">Status</span>
      <span class={[
        "text-xs px-2 py-0.5 rounded",
        @enquiry.status == "pending" && "bg-yellow-100 text-yellow-700",
        @enquiry.status == "replied" && "bg-green-100 text-green-700",
        @enquiry.status == "closed"  && "bg-gray-100 text-gray-500"
      ]}>
        <%= @enquiry.status %>
      </span>
    </div>
    <div class="flex justify-between">
      <span class="text-gray-500">Date</span>
      <span><%= Calendar.strftime(@enquiry.inserted_at, "%d %b %Y") %></span>
    </div>
  </div>

  <div class="border rounded p-4 mb-6">
    <p class="text-sm text-gray-500 mb-2">Message</p>
    <p class="text-sm leading-relaxed"><%= @enquiry.message %></p>
  </div>

  <div class="flex gap-4">
    <.link
      href={~p"/admin/enquiries/#{@enquiry.id}"}
      method="delete"
      data-confirm="Permanently delete this enquiry?"
      class="text-red-600 text-sm">
      Delete Enquiry
    </.link>
    <.link href={~p"/admin/enquiries"} class="text-gray-500 text-sm">
      ← Back to enquiries
    </.link>
  </div>
</div>