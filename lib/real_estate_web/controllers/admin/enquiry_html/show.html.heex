<div class="max-w-3xl p-6 mx-auto">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs text-gray-400 font-bold uppercase tracking-widest mb-2">
        <.link href={~p"/admin/enquiries"} class="hover:text-blue-600 transition-colors">Enquiry Logs</.link>
        <span>/</span>
        <span class="text-gray-900">Log Entry Audit</span>
      </div>
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Enquiry Details</h1>
    </div>
    
    <.link href={~p"/admin/enquiries"}
      class="bg-white border border-gray-200 text-gray-600 px-5 py-2 rounded-xl text-sm font-bold hover:bg-gray-50 transition-all shadow-sm">
      ← Back
    </.link>
  </div>

  <div class="bg-white rounded-2xl border shadow-sm overflow-hidden mb-6">
    <%!-- Status Banner --%>
    <div class={[
      "px-8 py-3 flex items-center justify-between border-b",
      @enquiry.status == "pending" && "bg-amber-50/50 border-amber-100",
      @enquiry.status == "replied" && "bg-emerald-50/50 border-emerald-100",
      @enquiry.status == "closed" && "bg-gray-50 border-gray-100"
    ]}>
      <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-400">Transaction Status</span>
      <span class={[
        "text-xs px-3 py-1 rounded-full font-bold uppercase tracking-tight shadow-sm border bg-white",
        @enquiry.status == "pending" && "text-amber-700 border-amber-200",
        @enquiry.status == "replied" && "text-emerald-700 border-emerald-200",
        @enquiry.status == "closed"  && "text-gray-500 border-gray-200"
      ]}>
        {@enquiry.status}
      </span>
    </div>

    <div class="p-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-10">
        <%!-- Property Relation --%>
        <div class="space-y-3">
          <p class="text-[10px] text-gray-400 uppercase font-bold tracking-widest">Inquired Listing</p>
          <div class="p-4 rounded-2xl border border-gray-100 bg-gray-50/30 group">
            <p class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors">{@enquiry.property.title}</p>
            <p class="text-xs text-gray-500 mt-1 uppercase tracking-tighter">Ref ID: {@enquiry.property.id}</p>
            <.link href={~p"/admin/properties/#{@enquiry.property.id}/edit"} class="mt-3 inline-block text-[10px] font-bold text-blue-600 hover:underline">
              Audit Property Details →
            </.link>
          </div>
        </div>

        <%!-- Buyer Relation --%>
        <div class="space-y-3">
          <p class="text-[10px] text-gray-400 uppercase font-bold tracking-widest">Lead Identity</p>
          <div class="p-4 rounded-2xl border border-gray-100 bg-gray-50/30 group">
            <p class="font-bold text-gray-900">{@enquiry.buyer.full_name || "Name Not Set"}</p>
            <p class="text-xs text-gray-500 mt-1 font-medium italic">{@enquiry.buyer.email}</p>
            <.link href={~p"/admin/users/#{@enquiry.buyer.id}"} class="mt-3 inline-block text-[10px] font-bold text-blue-600 hover:underline">
              Audit User Profile →
            </.link>
          </div>
        </div>
      </div>

      <%!-- Message Thread --%>
      <div class="space-y-3">
        <p class="text-[10px] text-gray-400 uppercase font-bold tracking-widest ml-1">Message Content</p>
        <div class="bg-gray-900 rounded-3xl p-8 text-gray-100 relative shadow-inner">
          <div class="absolute top-0 right-8 -translate-y-1/2 bg-blue-600 px-3 py-1 rounded-full text-[10px] font-black uppercase">
            {Calendar.strftime(@enquiry.inserted_at, "%d %b %Y")}
          </div>
          <p class="text-base leading-relaxed font-medium italic opacity-90">
            "{@enquiry.message}"
          </p>
        </div>
      </div>
    </div>
  </div>

  <%!-- Admin Security Zone --%>
  <div class="bg-rose-50 border border-rose-100 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-4">
    <div>
      <h3 class="font-black text-rose-900 text-sm uppercase tracking-tight">Danger Zone</h3>
      <p class="text-rose-700/70 text-xs mt-1">This action is permanent and will remove the enquiry from all agent dashboards.</p>
    </div>
    
    <.link
      href={~p"/admin/enquiries/#{@enquiry.id}"}
      method="delete"
      data-confirm="CRITICAL: Permanent deletion of log entry. This cannot be undone. Proceed?"
      class="bg-rose-600 text-white px-8 py-3 rounded-xl text-sm font-bold hover:bg-rose-700 shadow-lg shadow-rose-200 transition-all active:scale-95 whitespace-nowrap">
      Purge Enquiry Log
    </.link>
  </div>
</div>