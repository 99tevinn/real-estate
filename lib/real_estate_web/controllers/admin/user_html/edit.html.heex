<%!-- lib/real_estate_web/controllers/admin/user_html/edit.html.heex --%>
<div class="mx-auto max-w-lg mt-10 p-6">
  <h1 class="text-2xl font-semibold mb-2">Edit User</h1>
  <p class="text-gray-500 mb-6"><%= @user.email %></p>

  <.form :let={f} for={@changeset} action={~p"/admin/users/#{@user.id}"} method="post">
    <input type="hidden" name="_method" value="put" />

    <.input field={f[:full_name]} type="text" label="Full Name" />
    <.input field={f[:role]} type="select" label="Role"
      options={[
        {"Buyer / Tenant", "buyer"},
        {"Property Owner", "owner"},
        {"Agent / Realtor", "agent"},
        {"Admin", "admin"}
      ]} />
    <.input field={f[:active]} type="select" label="Status"
      options={[{"Active", "true"}, {"Inactive", "false"}]} />

    <.button type="submit" class="w-full mt-4">Save Changes</.button>
  </.form>

  <.link href={~p"/admin/users"} class="mt-4 inline-block text-sm text-gray-500">
    ← Back to users
  </.link>
</div>