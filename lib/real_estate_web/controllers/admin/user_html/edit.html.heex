<div class="max-w-3xl p-6 mx-auto">
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-rose-600 font-bold uppercase tracking-widest mb-2">
      <.link href={~p"/admin/users"} class="hover:underline text-gray-400">User Management</.link>
      <span class="text-gray-300">/</span>
      <span>Edit Permissions</span>
    </div>
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Modify User Account</h1>
    <p class="text-gray-500 text-sm mt-1 italic">Updating records for: {@user.email}</p>
  </div>

  <div class="bg-white rounded-2xl border shadow-sm relative overflow-hidden">
    <%!-- Warning bar for sensitive administrative actions --%>
    <div class="bg-amber-50 border-b border-amber-100 px-8 py-3 flex items-center gap-3">
      <span class="text-lg">⚠️</span>
      <p class="text-[11px] font-bold text-amber-800 uppercase tracking-tight">
        Caution: Changing user roles or status will immediately affect their platform permissions.
      </p>
    </div>

    <div class="p-8">
      <.form :let={f} for={@changeset} action={~p"/admin/users/#{@user.id}"} method="post" class="space-y-6">
        <input type="hidden" name="_method" value="put" />

        <div class="grid grid-cols-1 gap-6">
          <.input field={f[:full_name]} type="text" label="Display Name" placeholder="Full legal name" />
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <.input field={f[:role]} type="select" label="Access Level (Role)"
              options={[
                {"Buyer / Tenant",  "buyer"},
                {"Property Owner",  "owner"},
                {"Agent / Realtor", "agent"},
                {"System Admin",    "admin"}
              ]} 
              class="bg-gray-50 border-gray-200"
            />

            <.input field={f[:active]} type="select" label="Account Visibility"
              options={[{"Enabled / Active", "true"}, {"Disabled / Inactive", "false"}]} 
              class="bg-gray-50 border-gray-200"
            />
          </div>
        </div>

        <div class="flex items-center justify-between mt-10 pt-8 border-t border-gray-100">
          <p class="text-[10px] text-gray-400 max-w-xs leading-relaxed">
            All changes are logged. Deactivating a user will prevent them from logging in but will preserve their historical data.
          </p>
          
          <div class="flex items-center gap-4">
            <.link href={~p"/admin/users"} class="text-sm font-bold text-gray-400 hover:text-gray-600 px-4 py-2">
              Cancel
            </.link>
            
            <.button type="submit" 
              class="bg-gray-900 text-white px-10 py-3 rounded-xl font-bold hover:bg-black shadow-lg shadow-gray-200 transition-all active:scale-95">
              Commit Changes
            </.button>
          </div>
        </div>
      </.form>
    </div>
  </div>

  <%!-- Metadata footer --%>
  <div class="mt-6 flex justify-center gap-6">
    <div class="flex items-center gap-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
      <span class="w-2 h-2 rounded-full bg-gray-300"></span>
      Internal ID: {@user.id}
    </div>
    <div class="flex items-center gap-2 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
      <span class="w-2 h-2 rounded-full bg-gray-300"></span>
      Provider: Standard Email
    </div>
  </div>
</div>