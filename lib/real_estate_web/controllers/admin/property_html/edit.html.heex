<div class="max-w-4xl p-6 mx-auto">
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-rose-600 font-bold uppercase tracking-widest mb-2">
        <.link href={~p"/admin/properties"} class="hover:underline text-gray-400">Inventory Management</.link>
        <span class="text-gray-300">/</span>
        <span>Edit Property</span>
      </div>
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Admin Property Override</h1>
      <p class="text-gray-500 text-sm mt-1 italic">{@property.title}</p>
    </div>
    
    <div class="flex items-center gap-2 bg-gray-50 px-4 py-2 rounded-xl border border-gray-100">
      <span class="text-[10px] font-black text-gray-400 uppercase tracking-tighter">Property ID</span>
      <code class="text-xs font-mono font-bold text-blue-600">{@property.id}</code>
    </div>
  </div>

  <div class="bg-white rounded-2xl border shadow-sm relative overflow-hidden">
    <%!-- Administrative header accent --%>
    <div class="h-1.5 bg-gradient-to-r from-rose-500 via-gray-900 to-rose-500"></div>

    <div class="p-8">
      <.form :let={f} for={@changeset} action={~p"/admin/properties/#{@property.id}"} method="post" class="space-y-8">
        <input type="hidden" name="_method" value="put" />
        
        <%!-- Section: Marketing Content --%>
        <div class="space-y-6">
          <h3 class="text-sm font-bold text-gray-900 border-b pb-2">Listing Content</h3>
          <div class="grid grid-cols-1 gap-6">
            <.input field={f[:title]} type="text" label="Property Title" required class="bg-gray-50/50" />
            <.input field={f[:description]} type="textarea" label="Internal & Public Description" rows="6" class="bg-gray-50/50" />
          </div>
        </div>

        <%!-- Section: Logistics & Financials --%>
        <div class="space-y-6 pt-4">
          <h3 class="text-sm font-bold text-gray-900 border-b pb-2">Logistics & Financials</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-6">
              <.input field={f[:location]} type="text" label="Geographic Location" required />
              <.input field={f[:price]} type="number" label="Price (KES)" required />
            </div>
            
            <div class="space-y-6">
              <.input field={f[:type]} type="select" label="Listing Category"
                options={[{"For Sale", "sale"}, {"For Rent", "rent"}]} />
                
              <.input field={f[:status]} type="select" label="Market Status"
                options={[{"Available", "available"}, {"Sold", "sold"}, {"Rented", "rented"}]} />
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between mt-12 pt-8 border-t border-gray-100">
          <.link href={~p"/admin/properties"} class="text-sm font-bold text-gray-400 hover:text-gray-600 px-4 py-2">
            Cancel Changes
          </.link>
          
          <div class="flex items-center gap-4">
            <p class="hidden md:block text-[10px] text-gray-400 font-medium text-right max-w-[150px]">
              Last Modified: {Calendar.strftime(@property.updated_at, "%d %b, %H:%M")}
            </p>
            <.button type="submit" 
              class="bg-gray-900 text-white px-10 py-3 rounded-xl font-bold hover:bg-black shadow-lg shadow-gray-200 transition-all active:scale-95">
              Update Listing
            </.button>
          </div>
        </div>
      </.form>
    </div>
  </div>
</div>