<%!-- lib/real_estate_web/controllers/listing_html/show.html.heex --%>
<div class="max-w-5xl mx-auto px-6 py-12">
  <.link href={~p"/listings"}
    class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-8 inline-flex items-center gap-2 hover:text-blue-600 transition-colors group">
    <span class="group-hover:-translate-x-1 transition-transform">←</span> Back to Marketplace
  </.link>

  <div class="bg-white rounded-3xl border shadow-xl shadow-gray-100/50 overflow-hidden mt-6">
    <%!-- Hero Image Section --%>
    <div class="relative h-[450px] w-full">
      <%= if @listing.image do %>
        <img
          src={RealEstate.Uploaders.PropertyImage.url({@listing.image, @listing}, :original)}
          class="w-full h-full object-cover"
        />
      <% else %>
        <div class="w-full h-full bg-gradient-to-br from-gray-900 via-gray-800 to-blue-900 flex flex-col items-center justify-center">
          <span class="text-7xl mb-4">🏘️</span>
          <p class="text-gray-400 text-xs font-bold uppercase tracking-[0.3em]">No Image Available</p>
        </div>
      <% end %>

      <%!-- Floating Status Badges --%>
      <div class="absolute top-6 left-6 flex gap-2">
        <span class={[
          "text-[10px] px-4 py-1.5 rounded-full font-black uppercase tracking-widest shadow-lg backdrop-blur-md",
          @listing.type == "sale" && "bg-blue-600/90 text-white",
          @listing.type == "rent" && "bg-emerald-600/90 text-white"
        ]}>
          {if @listing.type == "sale", do: "For Sale", else: "For Rent"}
        </span>
        <span class="text-[10px] bg-white/90 text-gray-900 px-4 py-1.5 rounded-full font-black uppercase tracking-widest shadow-lg backdrop-blur-md">
          {@listing.status}
        </span>
      </div>
    </div>

    <div class="p-10 md:p-12">
      <div class="flex flex-col lg:flex-row justify-between items-start gap-8">
        <div class="flex-1 space-y-4">
          <div>
            <p class="text-blue-600 text-xs font-bold uppercase tracking-widest mb-2 flex items-center gap-2">
              <span class="text-base">📍</span> {@listing.location}
            </p>
            <h1 class="text-4xl font-black text-gray-900 tracking-tight leading-tight">{@listing.title}</h1>
          </div>
          
          <div class="inline-block bg-gray-50 border border-gray-100 px-6 py-3 rounded-2xl">
            <p class="text-gray-400 text-[10px] font-black uppercase tracking-widest mb-1">Asking Price</p>
            <p class="text-4xl font-black text-gray-900">
              <span class="text-xl font-bold text-blue-600 mr-1">KES</span>{Decimal.to_float(@listing.price)}
            </p>
          </div>
        </div>

        <%!-- Action Sidebar/Section --%>
        <div class="w-full lg:w-80">
          <%= if assigns[:current_user] && assigns[:current_user].role == "buyer" do %>
            <div class="bg-gray-50 rounded-3xl p-6 border border-gray-100 space-y-4 shadow-sm">
              <h3 class="text-sm font-bold text-gray-900 mb-2">Interested in this property?</h3>
              <.link
                href={~p"/buyer/enquiries/new?property_id=#{@listing.id}"}
                class="block text-center bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-2xl font-bold transition shadow-lg shadow-blue-100 active:scale-95">
                Send Enquiry
              </.link>
              
              <form action={~p"/buyer/saved"} method="post">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="property_id" value={@listing.id} />
                <button type="submit"
                  class="w-full bg-white border border-gray-200 text-gray-900 hover:bg-gray-50 py-4 rounded-2xl font-bold transition active:scale-95 flex items-center justify-center gap-2">
                  <span class="text-rose-500">❤️</span> Save to Favorites
                </button>
              </form>
            </div>
          <% else %>
            <div class="bg-blue-900 rounded-3xl p-8 text-white space-y-6 shadow-xl shadow-blue-100">
              <div class="space-y-2">
                <h3 class="text-xl font-black tracking-tight leading-tight">Start your journey today</h3>
                <p class="text-blue-200 text-xs leading-relaxed">Join our marketplace to contact agents, schedule viewings, and save listings.</p>
              </div>
              <.link
                href={~p"/register"}
                class="block text-center bg-white text-blue-900 py-4 rounded-2xl font-black transition hover:bg-blue-50 active:scale-95 text-sm uppercase tracking-widest">
                Create Account
              </.link>
              <p class="text-[10px] text-blue-300 text-center uppercase font-bold tracking-widest">
                Already a member? <.link href={~p"/login"} class="text-white hover:underline">Log in</.link>
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Property Details Section --%>
      <%= if @listing.description do %>
        <div class="mt-12 pt-10 border-t border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-xl">📄</span>
            <h2 class="text-xl font-black text-gray-900 tracking-tight">Property Description</h2>
          </div>
          <div class="prose prose-blue max-w-none">
            <p class="text-gray-600 text-lg leading-relaxed whitespace-pre-line">{@listing.description}</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%!-- Safety Note --%>
  <div class="mt-8 flex justify-center">
    <div class="flex items-center gap-3 bg-gray-50 px-6 py-3 rounded-full border border-gray-200">
      <span class="text-lg">🛡️</span>
      <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest">
        Verified Listing &middot; Professional Realtor Representation
      </p>
    </div>
  </div>
</div>