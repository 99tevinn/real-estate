<%!-- Add this at the top of the listing card --%>
<%= if @listing.image do %>
  <img
    src={RealEstate.Uploaders.PropertyImage.url({@listing.image, @listing}, :thumb)}
    class="w-full h-48 object-cover rounded mb-4"
  />
<% else %>
  <div class="w-full h-48 bg-gray-100 rounded mb-4 flex items-center justify-center">
    <p class="text-gray-400 text-sm">No image</p>
  </div>
<% end %>

<div class="max-w-2xl mx-auto px-6 py-10">
  <.link href={~p"/listings"} class="text-sm text-gray-500 mb-6 inline-block">
    ← Back to listings
  </.link>
  <div class="border rounded-lg p-6">
    <div class="flex items-center justify-between mb-4">
      <span class={[
        "text-xs px-2 py-0.5 rounded font-medium",
        @listing.type == "sale" && "bg-blue-100 text-blue-700",
        @listing.type == "rent" && "bg-green-100 text-green-700"
      ]}>
        {if @listing.type == "sale", do: "For Sale", else: "For Rent"}
      </span> <span class="text-xs text-gray-400 capitalize">{@listing.status}</span>
    </div>
    
    <h1 class="text-2xl font-bold mb-2">{@listing.title}</h1>
    
    <p class="text-gray-500 mb-4">{@listing.location}</p>
    
    <p class="text-3xl font-bold text-blue-600 mb-6">KES {@listing.price}</p>
    
    <%= if @listing.description do %>
      <div class="border-t pt-4 mb-6">
        <h2 class="font-semibold mb-2">Description</h2>
        
        <p class="text-gray-600 text-sm leading-relaxed">{@listing.description}</p>
      </div>
    <% end %>
     <%!-- Enquire button — only for logged in buyers --%>
    <div class="max-w-2xl mx-auto px-6 py-10">
      <.link
        href={~p"/listings"}
        class="text-sm text-gray-500 hover:text-blue-600 mb-6 inline-block transition"
      >
        ← Back to listings
      </.link>
      <div class="bg-white shadow-sm border rounded-xl overflow-hidden">
        <div class="p-8">
          <div class="flex items-center justify-between mb-4">
            <span class={[
              "text-xs px-2.5 py-1 rounded-full font-bold uppercase tracking-wider",
              @listing.type == "sale" && "bg-blue-100 text-blue-700",
              @listing.type == "rent" && "bg-emerald-100 text-emerald-700"
            ]}>
              {if @listing.type == "sale", do: "For Sale", else: "For Rent"}
            </span>
            <span class="text-xs font-semibold text-gray-400 bg-gray-50 px-2 py-1 rounded uppercase">
              {@listing.status}
            </span>
          </div>
          
          <h1 class="text-3xl font-extrabold text-gray-900 mb-2">{@listing.title}</h1>
          
          <p class="text-gray-500 flex items-center mb-6">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 mr-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg> {@listing.location}
          </p>
          
          <div class="bg-blue-50 p-4 rounded-lg mb-8">
            <p class="text-sm text-blue-600 font-semibold uppercase">Price</p>
            
            <p class="text-4xl font-black text-blue-700">KES {@listing.price}</p>
          </div>
          
          <%= if @listing.description do %>
            <div class="border-t border-gray-100 pt-6 mb-8">
              <h2 class="text-lg font-bold text-gray-900 mb-3">About this property</h2>
              
              <p class="text-gray-600 leading-relaxed">{@listing.description}</p>
            </div>
          <% end %>
          
          <div class="space-y-3">
            <%= if assigns[:current_user] && assigns[:current_user].role == "buyer" do %>
              <.link
                href={~p"/buyer/enquiries/new?property_id=#{@listing.id}"}
                class="block text-center bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-xl font-bold shadow-sm transition"
              >
                Send Enquiry
              </.link>
              <form action={~p"/buyer/saved"} method="post">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="property_id" value={@listing.id} />
                <button
                  type="submit"
                  class="w-full border py-3 rounded font-medium text-gray-600 hover:bg-gray-50"
                >
                  Save Property
                </button>
              </form>
            <% else %>
              <%= if !assigns[:current_user] do %>
                <.link
                  href={~p"/register"}
                  class="block text-center bg-indigo-600 hover:bg-indigo-700 text-white py-4 rounded-xl font-bold shadow-sm transition"
                >
                  Register to Enquire
                </.link>
                <p class="text-center text-sm text-gray-400 mt-2">
                  Already have an account?
                  <.link href={~p"/login"} class="text-indigo-600 font-semibold">Log in</.link>
                </p>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
