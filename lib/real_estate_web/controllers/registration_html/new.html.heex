<%!-- registration_html/new.html.heex --%>
<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <span class="text-4xl">🏠</span>
      <h1 class="text-2xl font-bold mt-2">Create an account</h1>
      <p class="text-gray-500 text-sm mt-1">Join thousands of users on RealEstate</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border p-8">
      <.form :let={f} for={@changeset} action={~p"/register"} method="post">
        <.input field={f[:full_name]} type="text"     label="Full Name" />
        <.input field={f[:email]}     type="email"    label="Email"     required />
        <.input field={f[:password]}  type="password" label="Password"  required />
        <.input field={f[:role]}      type="select"   label="I am a ..."
          options={[
            {"Buyer / Tenant",  "buyer"},
            {"Property Owner",  "owner"},
            {"Agent / Realtor", "agent"}
          ]} />

        <.button type="submit" class="w-full mt-4 bg-gray-900 text-white py-3 rounded-lg
                                       font-semibold hover:bg-gray-700 transition">
          Create Account
        </.button>
      </.form>
    </div>

    <p class="mt-6 text-sm text-center text-gray-500">
      Already have an account?
      <.link href={~p"/login"} class="text-blue-600 font-medium hover:underline">
        Sign in
      </.link>
    </p>
  </div>
</div>