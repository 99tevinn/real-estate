<%!-- owner/property_html/edit.html.heex --%>
<div class="mx-auto max-w-lg mt-10 p-6">
  <h1 class="text-2xl font-semibold mb-2">Edit Property</h1>
  
  <p class="text-gray-500 mb-6">{@property.title}</p>
   <%!-- Show existing image --%>
  <%= if @property.image do %>
    <div class="mb-4">
      <p class="text-sm text-gray-500 mb-2">Current Image</p>
      
      <img
        src={RealEstate.Uploaders.PropertyImage.url({@property.image, @property}, :thumb)}
        class="w-full h-48 object-cover rounded"
      />
    </div>
  <% end %>
  
  <.form
    :let={f}
    for={@changeset}
    action={~p"/owner/properties/#{@property.id}"}
    method="post"
    multipart={true}
  >
    <input type="hidden" name="_method" value="put" />
    <.input field={f[:title]} type="text" label="Title" required />
    <.input field={f[:description]} type="textarea" label="Description" />
    <.input field={f[:location]} type="text" label="Location" required />
    <.input field={f[:price]} type="number" label="Price (KES)" required />
    <.input
      field={f[:type]}
      type="select"
      label="Listing Type"
      options={[{"For Sale", "sale"}, {"For Rent", "rent"}]}
    />
    <.input
      field={f[:status]}
      type="select"
      label="Status"
      options={[{"Available", "available"}, {"Sold", "sold"}, {"Rented", "rented"}]}
    />
    <div class="mb-4">
      <label class="block text-sm font-medium mb-1">Replace Image (optional)</label>
      <input
        type="file"
        name="property[image]"
        accept=".jpg,.jpeg,.png,.webp"
        class="w-full text-sm"
      />
    </div>
     <.button type="submit" class="w-full mt-4">Update Property</.button>
  </.form>
  
  <.link href={~p"/owner/properties"} class="mt-4 inline-block text-sm text-gray-500">
    ← Back to my properties
  </.link>
</div>
