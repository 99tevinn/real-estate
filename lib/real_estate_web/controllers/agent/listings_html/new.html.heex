<div class="max-w-3xl p-6 mx-auto">
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs text-blue-600 font-bold uppercase tracking-widest mb-2">
      <.link href={~p"/agent/listings"} class="hover:underline text-gray-400">My Listings</.link>
      <span class="text-gray-300">/</span>
      <span>New Entry</span>
    </div>
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Create New Listing</h1>
    <p class="text-gray-500 text-sm mt-1">Add a new property to your portfolio and push it live to the marketplace.</p>
  </div>

  <div class="bg-white rounded-2xl border shadow-sm p-8">
    <.form :let={f} for={@changeset} action={~p"/agent/listings"} method="post" class="space-y-6">
      
      <div class="grid grid-cols-1 gap-6">
        <.input field={f[:title]} type="text" label="Listing Title" placeholder="e.g. Luxury 4BR Villa with Private Pool" required />
        
        <.input field={f[:description]} type="textarea" label="Property Description" placeholder="Highlight key features, nearby amenities, and square footage..." rows="5" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <.input field={f[:location]} type="text" label="Location" placeholder="Street, Neighborhood, City" required />
        
        <.input field={f[:price]} type="number" label="Price (KES)" placeholder="0.00" required />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 border-t border-gray-50 pt-6">
        <.input field={f[:type]} type="select" label="Listing Category"
          options={[{"For Sale", "sale"}, {"For Rent", "rent"}]} />
          
        <.input field={f[:status]} type="select" label="Availability Status"
          options={[{"Available", "available"}, {"Sold", "sold"}, {"Rented", "rented"}]} />
      </div>

      <div class="flex items-center justify-end gap-4 border-t border-gray-100 pt-8">
        <.link href={~p"/agent/listings"} class="text-sm font-bold text-gray-400 hover:text-gray-600 px-4 py-2">
          Discard
        </.link>
        
        <.button type="submit" 
          class="bg-blue-600 text-white px-10 py-3 rounded-xl font-bold hover:bg-blue-700 shadow-md shadow-blue-100 transition-all active:scale-95">
          Publish Listing
        </.button>
      </div>
    </.form>
  </div>

  <%!-- Quick Guide --%>
  <div class="mt-6 p-4 bg-gray-50 rounded-xl border border-gray-200 flex items-start gap-3">
    <span class="text-lg">💡</span>
    <p class="text-[11px] text-gray-500 leading-relaxed">
      <strong>Pro Tip:</strong> Detailed descriptions with clear location data increase lead volume by up to 40%. Ensure your price is competitive for the current market in { @property_context[:market_area] || "Nairobi" }.
    </p>
  </div>
</div>