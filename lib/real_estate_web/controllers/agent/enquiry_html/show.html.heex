<div class="mx-auto max-w-lg mt-10 p-6">
  <h1 class="text-2xl font-semibold mb-2">Enquiry Details</h1>
  
  <p class="text-gray-500 mb-6">{@enquiry.property.title} ·
    From: {@enquiry.buyer.full_name || @enquiry.buyer.email}</p>
  
  <div class="border rounded p-4 mb-6 text-sm text-gray-700">{@enquiry.message}</div>
  
  <.form for={@enquiry} action={~p"/agent/enquiries/#{@enquiry.id}"} method="post">
    <input type="hidden" name="_method" value="put" />
    <div class="mb-4">
      <label class="block text-sm font-medium mb-1">Update Status</label>
      <select name="enquiry[status]" class="border rounded px-3 py-2 text-sm w-full">
        <option value="pending" selected={@enquiry.status == "pending"}>Pending</option>
        
        <option value="replied" selected={@enquiry.status == "replied"}>Replied</option>
        
        <option value="closed" selected={@enquiry.status == "closed"}>Closed</option>
      </select>
    </div>
     <.button type="submit" class="w-full">Update Status</.button>
  </.form>
  
  <.link href={~p"/agent/enquiries"} class="mt-4 inline-block text-sm text-gray-500">
    ← Back to enquiries
  </.link>
</div>
