<%!-- lib/real_estate_web/controllers/agent/enquiry_html/index.html.heex --%>
<div class="p-6 max-w-5xl mx-auto">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2">
        Pending Enquiries
        <span class="bg-blue-100 text-blue-700 text-xs px-2 py-0.5 rounded-full font-bold">
          {length(@enquiries)}
        </span>
      </h1>
      <p class="text-gray-500 text-sm mt-1">Review incoming leads and manage property enquiries.</p>
    </div>
  </div>

  <%= if Enum.empty?(@enquiries) do %>
    <div class="text-center py-24 bg-white rounded-2xl border-2 border-dashed border-gray-200">
      <div class="bg-gray-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="text-4xl">✅</span>
      </div>
      <h3 class="text-lg font-bold text-gray-900">Inbox is empty</h3>
      <p class="text-gray-500 max-w-xs mx-auto">You've responded to all current enquiries. Great job!</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 gap-4">
      <div :for={enq <- @enquiries}
        class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 hover:shadow-md hover:border-blue-200 transition-all group">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-1">
              <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse" title="Needs Response"></span>
              <p class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                {enq.property.title}
              </p>
            </div>
            
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500 font-medium">
              <div class="flex items-center gap-1.5">
                <div class="w-5 h-5 rounded-full bg-gray-100 flex items-center justify-center text-[10px] font-bold text-gray-600 uppercase">
                  {String.at(enq.buyer.full_name || "B", 0)}
                </div>
                <span>{enq.buyer.full_name || enq.buyer.email}</span>
              </div>
              <span class="text-gray-300">•</span>
              <span class="flex items-center gap-1">
                📅 {Calendar.strftime(enq.inserted_at, "%d %b %Y")}
              </span>
              <span class="text-gray-300">•</span>
              <span class="text-blue-600 bg-blue-50 px-2 py-0.5 rounded font-bold uppercase tracking-tighter text-[9px]">
                {enq.property.type}
              </span>
            </div>
          </div>

          <div class="md:text-right flex items-center gap-4">
            <div class="hidden lg:block">
              <p class="text-[10px] text-gray-400 uppercase font-bold tracking-widest">Property Price</p>
              <p class="text-sm font-black text-gray-900">KES {enq.property.price}</p>
            </div>
            <.link href={~p"/agent/enquiries/#{enq.id}"}
              class="bg-gray-900 text-white text-xs font-bold px-5 py-2.5 rounded-xl hover:bg-gray-700 transition-all shadow-sm active:scale-95 flex items-center gap-2">
              Review Lead <span class="opacity-50">→</span>
            </.link>
          </div>
        </div>

        <%!-- Message Snippet --%>
        <div class="mt-4 pt-4 border-t border-gray-50">
          <p class="text-sm text-gray-600 leading-relaxed line-clamp-1 italic bg-gray-50 px-3 py-2 rounded-lg border-l-4 border-gray-200">
            "{enq.message}"
          </p>
        </div>
      </div>
    </div>
  <% end %>
</div>