<div class="p-6">
  <h1 class="text-2xl font-semibold mb-6">Pending Enquiries</h1>

  <ul class="space-y-3">
    <li :for={enq <- @enquiries} class="border rounded p-4 text-sm">
      <div class="flex items-center justify-between mb-1">
        <p class="font-medium"><%= enq.property.title %></p>
        <.link href={~p"/agent/enquiries/#{enq.id}"} class="text-blue-600 text-xs">
          View & Update →
        </.link>
      </div>
      <p class="text-gray-600 truncate"><%= enq.message %></p>
      <p class="text-xs text-gray-400 mt-1">
        From: <%= enq.buyer.full_name || enq.buyer.email %> ·
        <%= Calendar.strftime(enq.inserted_at, "%d %b %Y") %>
      </p>
    </li>
  </ul>
</div>