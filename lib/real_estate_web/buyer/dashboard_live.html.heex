<%!-- lib/real_estate_web/live/buyer/dashboard_live.html.heex --%>
<div class="p-6">
  <h1 class="text-2xl font-semibold mb-6">
    Welcome, <%= @current_user.full_name %>!
  </h1>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <h2 class="text-lg font-medium mb-3">Available Properties</h2>
      <ul class="space-y-2">
        <li :for={prop <- @listings} class="border rounded p-3 text-sm">
          <p class="font-medium"><%= prop.title %></p>
          <p class="text-gray-500"><%= prop.location %> · KES <%= prop.price %></p>
          <.link
            href={~p"/buyer/enquiries/new?property_id=#{prop.id}"}
            class="text-xs text-blue-600 mt-1 inline-block">
            Enquire
          </.link>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-lg font-medium mb-3">My Enquiries</h2>
      <ul class="space-y-2">
        <li :for={enq <- @enquiries} class="border rounded p-3 text-sm">
          <p class="font-medium"><%= enq.property.title %></p>
          <p class="text-gray-500 truncate"><%= enq.message %></p>
          <span class="text-xs text-gray-400"><%= enq.status %></span>
        </li>
      </ul>
    </div>
  </div>
</div>