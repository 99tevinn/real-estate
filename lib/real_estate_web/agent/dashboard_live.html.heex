<%!-- lib/real_estate_web/live/agent/dashboard_live.html.heex --%>
<div class="p-6">
  <div class="mb-8 flex justify-between items-end">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
        Agent Dashboard
        <span class="flex h-2 w-2 rounded-full bg-blue-500 animate-pulse" title="Live Enquiry Tracking"></span>
      </h1>
      <p class="text-gray-500 text-sm mt-1">Manage your listings and incoming enquiries</p>
    </div>
  </div>

  <%!-- Stat cards --%>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
    <div class="bg-gray-900 text-white rounded-xl p-6 shadow-lg">
      <p class="text-gray-400 text-sm mb-1 uppercase tracking-wider font-semibold">My Active Listings</p>
      <p class="text-4xl font-bold">{length(@listings)}</p>
    </div>
    
    <div class="bg-blue-600 text-white rounded-xl p-6 shadow-lg">
      <p class="text-blue-200 text-sm mb-1 uppercase tracking-wider font-semibold">Pending Enquiries</p>
      <p class="text-4xl font-bold">{length(@pending_enquiries)}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <%!-- My listings column --%>
    <div class="bg-white rounded-xl border shadow-sm flex flex-col">
      <div class="px-6 py-4 border-b flex items-center justify-between bg-white sticky top-0 rounded-t-xl">
        <h2 class="font-bold text-gray-900">My Listings</h2>
        <.link href={~p"/agent/listings/new"}
          class="text-xs bg-gray-900 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-all font-semibold">
          + Add New Property
        </.link>
      </div>
      
      <ul class="divide-y divide-gray-100 overflow-y-auto max-h-[500px]">
        <li :for={listing <- @listings} class="px-6 py-5 hover:bg-gray-50 transition-colors">
          <div class="flex justify-between items-start mb-2">
            <div>
              <p class="font-bold text-gray-900">{listing.title}</p>
              <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                <span class="opacity-70">📍</span>{listing.location}
              </p>
            </div>
            <span class={[
              "text-[10px] px-2.5 py-1 rounded-full font-bold uppercase tracking-tight",
              listing.status == "available" && "bg-green-100 text-green-700",
              listing.status == "sold"      && "bg-gray-100 text-gray-600",
              listing.status == "rented"    && "bg-blue-100 text-blue-700"
            ]}>
              {listing.status}
            </span>
          </div>
          
          <div class="flex items-center justify-between mt-4 pt-3 border-t border-dashed border-gray-100">
            <p class="text-md font-extrabold text-gray-900">
              <span class="text-xs font-normal text-gray-400 mr-1">KES</span>{listing.price}
            </p>
            <.link href={~p"/agent/listings/#{listing.id}/edit"} class="text-xs text-blue-600 font-bold hover:underline">
              Edit Details
            </.link>
          </div>
        </li>
        
        <li :if={Enum.empty?(@listings)} class="px-6 py-12 text-center text-gray-400">
          <div class="text-3xl mb-2">🏠</div>
          <p class="text-sm">You haven't added any listings yet.</p>
        </li>
      </ul>
    </div>

    <%!-- Pending enquiries column --%>
    <div class="bg-white rounded-xl border shadow-sm flex flex-col">
      <div class="px-6 py-4 border-b flex items-center justify-between bg-white sticky top-0 rounded-t-xl">
        <h2 class="font-bold text-gray-900">Pending Enquiries</h2>
        <.link href={~p"/agent/enquiries"}
          class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">
          View all →
        </.link>
      </div>
      
      <ul class="divide-y divide-gray-100 overflow-y-auto max-h-[500px]">
        <li :for={enq <- @pending_enquiries} class="px-6 py-5 hover:bg-gray-50 transition-colors">
          <div class="flex justify-between items-start mb-1">
            <p class="font-bold text-gray-900">{enq.property.title}</p>
            <span class="text-[10px] text-gray-400 uppercase font-semibold">New</span>
          </div>
          <p class="text-sm text-gray-600 italic line-clamp-2 mt-1">"{enq.message}"</p>
          
          <div class="mt-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 bg-blue-100 rounded-full flex items-center justify-center text-[10px] font-bold text-blue-700 uppercase">
                {String.at(enq.buyer.full_name || "U", 0)}
              </div>
              <p class="text-xs font-semibold text-gray-700">
                {enq.buyer.full_name || enq.buyer.email}
              </p>
            </div>
            <.link href={~p"/agent/enquiries/#{enq.id}"} class="text-xs bg-blue-50 text-blue-700 px-3 py-1.5 rounded-lg font-bold hover:bg-blue-100 transition-colors">
              Reply
            </.link>
          </div>
        </li>
        
        <li :if={Enum.empty?(@pending_enquiries)} class="px-6 py-12 text-center text-gray-400">
          <div class="text-3xl mb-2">📩</div>
          <p class="text-sm">No pending enquiries at the moment.</p>
        </li>
      </ul>
    </div>
  </div>
</div>